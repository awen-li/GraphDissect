{
    "id": 34,
    "name": "34_dump",
    "driver": "cppcheck",
    "args": [
        "--quiet",
        "--template={file}:{line}:{severity}:{id}:{message}",
        "--output-format=text",
        "--dump"
    ],
    "seed_dir": "seeds",
    "output": "--output-file .",
    "priority": 1.0,
    "description": "Write .dump files per translation unit (AST/token/valueflow)."
}