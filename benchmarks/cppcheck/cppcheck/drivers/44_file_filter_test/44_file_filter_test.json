{
    "id": 44,
    "name": "44_file_filter_test",
    "driver": "cppcheck",
    "args": [
        "--quiet",
        "--template={file}:{line}:{severity}:{id}:{message}",
        "--output-format=text",
        "--file-filter *test*"
    ],
    "seed_dir": "seeds",
    "output": "",
    "priority": 1.0,
    "description": "Restrict analysis to files matching filter."
}