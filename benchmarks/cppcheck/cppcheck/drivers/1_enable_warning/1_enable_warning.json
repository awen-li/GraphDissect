{
    "id": 1,
    "name": "1_enable_warning",
    "driver": "cppcheck",
    "args": [
        "--quiet",
        "--template={file}:{line}:{severity}:{id}:{message}",
        "--output-format=text",
        "--enable warning"
    ],
    "seed_dir": "seeds",
    "output": "",
    "priority": 1.0,
    "description": "Enable checks grouped by severity (increases analysis surface)."
}