{
    "id": 2,
    "name": "2_enable_performance",
    "driver": "cppcheck",
    "args": [
        "--quiet",
        "--template={file}:{line}:{severity}:{id}:{message}",
        "--output-format=text",
        "--enable performance"
    ],
    "seed_dir": "seeds",
    "output": "",
    "priority": 1.0,
    "description": "Enable checks grouped by severity (increases analysis surface)."
}