{
    "id": 35,
    "name": "35_cppcheck_build_dir_out_builddir",
    "driver": "cppcheck",
    "args": [
        "--quiet",
        "--template={file}:{line}:{severity}:{id}:{message}",
        "--output-format=text",
        "--cppcheck-build-dir out/builddir"
    ],
    "seed_dir": "seeds",
    "output": "--output-file .",
    "priority": 1.0,
    "description": "Enable work folder for caching + whole program analysis."
}